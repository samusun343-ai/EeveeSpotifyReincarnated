<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The group list AND its order deliberately mirror Spotify.app's own
	  entitlements (verified against the Spotify 9.2.2 binary:
	  ['group.com.spotify.client.notification',
	   'group.com.spotify.client.widget']).

	  Order matters: the sideload bridge (modules/zxPluginsInject) resolves
	  the shared container from the FIRST entitled group of each process
	  and appends the suite name to it. The main app and this extension
	  only land on the same container if their first group is the same.
	  The payload itself is exchanged through the
	  'group.com.spotify.client.widget' UserDefaults suite — see
	  EeveeLyricsWidget.swift and LyricsWidgetBridge.swift.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.spotify.client.notification</string>
		<string>group.com.spotify.client.widget</string>
	</array>
</dict>
</plist>
