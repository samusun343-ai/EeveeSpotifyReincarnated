// Lyrics

lyrics_source = "Fonte de letras";
lyrics_source_description = "Você pode selecionar a letra de sua preferência.

Genius: Oferece letras de melhor qualidade, maior número de músicas e atualização das letras com mais rapidez. Não é e nunca será sincronizado com o tempo.

LRCLIB: Serviço com maior abertura, oferecendo letras sincronizadas com o tempo. No entanto, faltam letras para muitas músicas.";
lyrics_additional_info = "Se o ajuste não conseguir encontrar uma música ou processar a letra, você verá uma mensagem \"Não foi possível carregar a letra desta música\". A letra pode estar errada para algumas músicas ao usar o Genius devido a como o ajuste pesquisa músicas. Eu fiz isso funcionar na maioria dos casos.";
petitlyrics_description = "PetitLyrics: Oferece muitas letras japonesas sincronizadas com o tempo e algumas letras internacionais.";
lrcred_liriqo_description = "lrc.red + LRCLIB + LiriQo: Uma fonte de três estágios. O lrc.red responde primeiro, servindo letras sincronizadas por linha e por palavra, rápidas e em cache de CDN; se tiver apenas texto simples ou nada para uma música, o LRCLIB é consultado em seguida, e o LiriQo — que agrega 11 provedores — é o estágio final, com letras sincronizadas por palavra quando disponíveis.";

