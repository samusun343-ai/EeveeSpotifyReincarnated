lyrics_source = "Mahnı sözü mənbəyi";
lyrics_source_description = "İstədiyiniz mənbəni seçin:\n\nGenius: Ən yüksək keyfiyyətli mahnı sözlərini təqdim edir, sürətli yenilənir, lakin heç vaxt zamanla sinxronlaşdırılmış mahnı sözləri təqdim etmir və etməyəcək.\n\nLRCLIB: Tamamilə açıqdır, zamanla sinxronlaşdırılmış mahnı sözləri təqdim edir, lakin bəzi mahnılarda ümumiyyətlə mahnı sözləri yoxdur.";
lyrics_additional_info = "Əgər EeveeSpotify mahnını tapmasa və ya mahnı sözlərini işləyə bilməsə, 'Bu mahnıya mahnı sözləri tapılmadı' mesajı görünəcək. Genius istifadə edilərkən bəzi uyğunluq səhvləri ola bilər, çünki sistem öz axtarış metodundan istifadə edir — əksər hallarda düzgün işləyir.";
petitlyrics_description = "PetitLyrics: Yapon dilində və bəzi beynəlxalq mahnılar üçün zamanla sinxronlaşdırılmış mahnı sözləri təqdim edir.";
lrcred_liriqo_description = "lrc.red + LRCLIB + LiriQo: Üç mərhələli mənbə. Əvvəlcə lrc.red cavab verir, CDN keşli, sətir və söz sinxronlu mahnı sözlərini sürətlə təqdim edir; bir mahnı üçün yalnız düz mətni varsa və ya heç nə yoxdursa, növbəti LRCLIB-dən soruşulur və 11 provayderi birləşdirən LiriQo, mövcud olduqda söz sinxronlu sözlərlə son mərhələdir.";

